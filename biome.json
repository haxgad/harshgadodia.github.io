{
  "$schema": "https://biomejs.dev/schemas/2.4.1/schema.json",
  "files": {
    "includes": ["src/**/*.ts", "src/**/*.js", "*.mjs"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  }
}
