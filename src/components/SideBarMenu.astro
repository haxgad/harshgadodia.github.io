---
const pathname = Astro.url.pathname;
const activeClass = "bg-base-300";

const navItems = [
  { id: "home", href: "/", label: "About" },
  { id: "bookshelf", href: "/bookshelf", label: "Bookshelf" },
  { id: "concepts", href: "/concepts", label: "Concepts" },
  { id: "links", href: "/links", label: "Links" },
  { id: "quotes", href: "/quotes", label: "Quotes" },
];

function isActive(href: string): boolean {
  if (href === "/") {
    return pathname === "/" || pathname === "";
  }
  return pathname === href || pathname.startsWith(href + "/");
}
---

<ul class="menu grow shrink menu-md overflow-y-auto">
    {navItems.map((item) => (
        <li>
            <a
                class:list={["py-3 text-base", { [activeClass]: isActive(item.href) }]}
                id={item.id}
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
            >
                {item.label}
            </a>
        </li>
    ))}
</ul>
