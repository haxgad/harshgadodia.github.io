---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="pb-12 mt-5">
    <h1 class="text-2xl sm:text-3xl w-full font-bold mb-4">Bookshelf</h1>

    <p class="mb-6">
      <a
        href="https://www.goodreads.com/user/show/122474111"
        target="_blank"
        rel="noopener noreferrer"
        class="link link-primary"
      >
        Connect with me on Goodreads
      </a>
    </p>

    <!-- Loading skeleton -->
    <div id="bookshelf-skeleton" class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 gap-3 transition-opacity duration-500">
      {Array.from({ length: 16 }).map(() => (
        <div class="animate-pulse">
          <div class="bg-base-300 rounded-lg aspect-[2/3]"></div>
        </div>
      ))}
    </div>

    <div id="gr_grid_widget_1715093350"></div>

    <script is:inline>
      (function() {
        const GOODREADS_USER_ID = '122474111';
        const GOODREADS_WIDGET_ID = '1715093350';

        // Add dns-prefetch for Goodreads
        var dnsPrefetch = document.createElement('link');
        dnsPrefetch.rel = 'dns-prefetch';
        dnsPrefetch.href = 'https://www.goodreads.com';
        document.head.appendChild(dnsPrefetch);

        const skeleton = document.getElementById('bookshelf-skeleton');
        const widget = document.getElementById(`gr_grid_widget_${GOODREADS_WIDGET_ID}`);
        var loaded = false;

        function loadWidget() {
          if (loaded) return;
          loaded = true;
          var s = document.createElement('script');
          s.src = `https://www.goodreads.com/review/grid_widget/${GOODREADS_USER_ID}?cover_size=medium&hide_link=true&hide_title=true&num_books=50&order=d&shelf=read&sort=date_added&widget_id=${GOODREADS_WIDGET_ID}`;
          document.body.appendChild(s);

          const observer = new MutationObserver((mutations, obs) => {
            if (widget && widget.children.length > 0) {
              widget.style.display = 'grid';
              skeleton.style.opacity = '0';
              setTimeout(function() { skeleton.style.display = 'none'; }, 500);
              obs.disconnect();
            }
          });
          observer.observe(widget, { childList: true, subtree: true });

          // Fallback: if MutationObserver never fires after 10 seconds, show error
          setTimeout(function() {
            if (skeleton.style.display !== 'none') {
              skeleton.innerHTML = '<p class="text-base-content/60">Unable to load bookshelf. <a href="https://www.goodreads.com/user/show/122474111" class="link link-primary" target="_blank" rel="noopener noreferrer">View on Goodreads</a></p>';
              skeleton.style.display = 'block';
              skeleton.style.opacity = '1';
            }
          }, 10000);
        }

        var observer = new IntersectionObserver(function(entries) {
          if (entries[0].isIntersecting) {
            loadWidget();
            observer.disconnect();
          }
        }, { rootMargin: '200px' });

        observer.observe(widget);
      })();
    </script>

  </div>
</BaseLayout>

<style is:global>
  .gr_grid_book_container {
    padding: 10px;
    display: inline-block;
  }
  .gr_grid_book_container img {
    border-radius: 8px;
    transition: transform 0.2s ease;
  }
  .gr_grid_book_container img:hover {
    transform: scale(1.05);
  }
  .gr_grid_book_container noscript {
    display: none;
  }
</style>
