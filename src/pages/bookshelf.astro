---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout sideBarActiveItemID="bookshelf">
  <div class="pb-12 mt-5">
    <div class="text-3xl w-full font-bold mb-4">Bookshelf</div>

    <p class="mb-6">
      <a
        href="https://www.goodreads.com/user/show/122474111"
        target="_blank"
        class="link link-primary"
      >
        Connect with me on Goodreads
      </a>
    </p>

    <div id="gr_grid_widget_1715093350"></div>

    <script
      src="https://www.goodreads.com/review/grid_widget/122474111?cover_size=medium&hide_link=true&hide_title=true&num_books=200&order=d&shelf=read&sort=date_added&widget_id=1715093350"
      is:inline
    ></script>

  </div>
</BaseLayout>
