---
import ExternalLink from "../components/ExternalLink.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const GOODREADS_USER_ID = "122474111";
const GOODREADS_PROFILE = `https://www.goodreads.com/user/show/${GOODREADS_USER_ID}`;
const FEED_URL = `https://www.goodreads.com/review/list_rss/${GOODREADS_USER_ID}?shelf=read&sort=date_added&order=d`;

interface Book {
  title: string;
  link: string;
  image: string;
}

// Pull a single tag's text content, handling both CDATA-wrapped and plain values.
function extract(block: string, tag: string): string {
  const match = block.match(new RegExp(`<${tag}>(?:<!\\[CDATA\\[)?([\\s\\S]*?)(?:\\]\\]>)?</${tag}>`));
  return match ? match[1].trim() : "";
}

let books: Book[] = [];
let feedFailed = false;

try {
  const res = await fetch(FEED_URL, {
    headers: { "User-Agent": "Mozilla/5.0 (compatible; haxgad.com/build)" },
  });
  if (!res.ok) throw new Error(`Goodreads responded ${res.status}`);
  const xml = await res.text();
  books = xml
    .split("<item>")
    .slice(1)
    .map((block) => ({
      title: extract(block, "title"),
      link: extract(block, "link"),
      // Use the largest cover available and strip Goodreads' size suffix
      // (e.g. `12345._SY75_.jpg`) so we get full-resolution artwork.
      image: (extract(block, "book_large_image_url") || extract(block, "book_medium_image_url")).replace(
        /\._[A-Z]+\d+_\./,
        ".",
      ),
    }))
    .filter((book) => book.image)
    .slice(0, 50);
  if (books.length === 0) feedFailed = true;
} catch (error) {
  console.error("Failed to fetch Goodreads bookshelf:", error);
  feedFailed = true;
}
---

<BaseLayout>
  <div class="pb-12 mt-5">
    <h1 class="text-2xl sm:text-3xl w-full font-bold mb-4">Bookshelf</h1>

    <p class="mb-6">
      <ExternalLink href={GOODREADS_PROFILE}>Connect with me on Goodreads</ExternalLink>
    </p>

    {
      books.length > 0 ? (
        <div class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 gap-3">
          {books.map((book) => (
            <ExternalLink href={book.link} class="block" title={book.title}>
              <img
                src={book.image}
                alt={book.title}
                loading="lazy"
                decoding="async"
                width="98"
                height="147"
                class="rounded-lg w-full h-auto aspect-[2/3] object-cover transition-transform duration-200 hover:scale-105"
              />
            </ExternalLink>
          ))}
        </div>
      ) : (
        <p class="text-base-content/60">
          {feedFailed ? "Unable to load the bookshelf right now. " : "Nothing here yet. "}
          <ExternalLink href={GOODREADS_PROFILE}>View on Goodreads</ExternalLink>
        </p>
      )
    }
  </div>
</BaseLayout>
