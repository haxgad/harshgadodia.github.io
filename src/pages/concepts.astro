---
import Card from "../components/Card.astro";
import { concepts } from "../data/concepts";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="pb-12 mt-5">
    <h1 class="text-2xl sm:text-3xl w-full font-bold mb-6">Concepts</h1>
    <div class="space-y-4">
      {
        concepts.map((concept) => (
          <Card>
            <h2 class="card-title">
              <a
                href={concept.url}
                target="_blank"
                rel="noopener noreferrer"
                class="link link-primary"
              >
                {concept.title}
              </a>
            </h2>
            <p>{concept.description}</p>
            <p class="text-sm italic opacity-70">{concept.example}</p>
          </Card>
        ))
      }
    </div>
  </div>
</BaseLayout>
