---
import Card from "../components/Card.astro";
import ExternalLink from "../components/ExternalLink.astro";
import { concepts } from "../data/concepts";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="pb-12 mt-5">
    <h1 class="text-2xl sm:text-3xl w-full font-bold mb-6">Concepts</h1>
    <div class="space-y-4">
      {
        concepts.map((concept) => (
          <Card>
            <h2 class="card-title">
              <ExternalLink href={concept.url}>{concept.title}</ExternalLink>
            </h2>
            <p>{concept.description}</p>
            <p class="text-sm italic opacity-70">{concept.example}</p>
          </Card>
        ))
      }
    </div>
  </div>
</BaseLayout>
