---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-center mb-8">
      <img
        src="/profile.jpg"
        alt="Harsh Gadodia"
        class="w-48 h-48 rounded-full mx-auto object-cover"
      />
    </div>
    <div class="text-lg leading-relaxed space-y-4">
      <p>
        Hi, I'm Harsh, a Software Engineer based in Singapore.
      </p>
      <p>
        I studied Computer Engineering at the National University of Singapore and was part of the
        <a href="https://nuscollege.nus.edu.sg/" class="link link-primary" target="_blank">University Scholars Programme</a>
        (now NUSCollege), a liberal arts programme. In my second year, I interned as an iOS developer at
        <a href="https://www.getepic.com" class="link link-primary" target="_blank">Epic!</a>, an edtech startup in the Bay Area.
      </p>
      <p>
        In 2024, I completed my MBA at the
        <a href="https://quantic.edu/about/" class="link link-primary" target="_blank">Quantic School of Business and Technology</a>.
      </p>
    </div>
  </div>
</BaseLayout>
