---
import ExternalLink from "../components/ExternalLink.astro";
import ExternalLinkIcon from "../components/icons/ExternalLinkIcon.astro";
import { links } from "../data/links";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="pb-12 mt-5">
    <h1 class="text-2xl sm:text-3xl w-full font-bold mb-6">Links</h1>
    <p class="mb-8 text-lg">Here are some links that you might also enjoy.</p>
    {
      links.map((section) => (
        <div class="mb-8">
          <h2 class="text-2xl font-bold mb-4">{section.section}</h2>
          <div class="grid gap-3 sm:grid-cols-2">
            {section.items.map((item) => (
              <ExternalLink
                href={item.url}
                class="card bg-base-200 shadow-sm hover:shadow-md transition-shadow"
              >
                <div class="card-body p-4">
                  <h3 class="card-title text-base flex items-center gap-2">
                    {item.title}
                    <ExternalLinkIcon />
                  </h3>
                </div>
              </ExternalLink>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</BaseLayout>
