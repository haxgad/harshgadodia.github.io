---
import BaseLayout from "../layouts/BaseLayout.astro";
import { links } from "../data/links";
---

<BaseLayout sideBarActiveItemID="links">
  <div class="pb-12 mt-5">
    <div class="text-3xl w-full font-bold mb-6">Links</div>
    <p class="mb-8 text-lg">Here are some links that you might also enjoy.</p>
    {
      links.map((section) => (
        <div class="mb-8">
          <h2 class="text-2xl font-bold mb-4">{section.section}</h2>
          <ul class="list-disc ml-6 space-y-2">
            {section.items.map((item) => (
              <li>
                <a
                  href={item.url}
                  target="_blank"
                  class="link link-primary"
                >
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</BaseLayout>
