---
import BaseLayout from "../layouts/BaseLayout.astro";
import { links } from "../data/links";
---

<BaseLayout>
  <div class="pb-12 mt-5">
    <div class="text-2xl sm:text-3xl w-full font-bold mb-6">Links</div>
    <p class="mb-8 text-lg">Here are some links that you might also enjoy.</p>
    {
      links.map((section) => (
        <div class="mb-8">
          <h2 class="text-2xl font-bold mb-4">{section.section}</h2>
          <div class="grid gap-3 sm:grid-cols-2">
            {section.items.map((item) => (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="card bg-base-200 shadow-sm hover:shadow-md transition-shadow"
              >
                <div class="card-body p-4">
                  <h3 class="card-title text-base flex items-center gap-2">
                    {item.title}
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4 opacity-50 flex-shrink-0"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                      />
                    </svg>
                  </h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</BaseLayout>
